# Hirely configuration. Copy to .env and adjust as needed.
# Secret values are intentionally left EMPTY; never commit a filled-in .env.

# Active AI provider: "ollama" (default, local, zero cost) or "openrouter".
AI_PROVIDER=ollama

# Local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Model is selected at runtime from the installed list; no model is assumed.
OLLAMA_MODEL=

# OpenRouter. Required only when AI_PROVIDER=openrouter.
# The selected model must pass free verification before any request is sent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider HTTP behaviour.
REQUEST_TIMEOUT_S=60
MAX_RETRIES=2

# Upload handling (authoritative rejection size, in megabytes).
MAX_UPLOAD_MB=10

# Live market research. Disabled by default: the app uses the no-network
# disclosure path and never fabricates market data.
MARKET_SEARCH_ENABLED=false
# Optional keyless, documented market-search endpoint (opt-in).
MARKET_SEARCH_ENDPOINT=
# Listings older than this many days are flagged as stale.
MARKET_STALE_DAYS=45
